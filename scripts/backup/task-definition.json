{
  "family": "vibrationfit-db-backup",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::428923191740:role/vibrationfit-backup-exec-role",
  "taskRoleArn": "arn:aws:iam::428923191740:role/vibrationfit-backup-task-role",
  "containerDefinitions": [
    {
      "name": "db-backup",
      "image": "428923191740.dkr.ecr.us-east-2.amazonaws.com/vibrationfit-db-backup:latest",
      "essential": true,
      "environment": [
        { "name": "S3_BUCKET", "value": "vibrationfit-db-backups" },
        { "name": "S3_PREFIX", "value": "vibrationfit" },
        { "name": "AWS_DEFAULT_REGION", "value": "us-east-2" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:428923191740:secret:vibrationfit/db-backup-url-nAq8Xd"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vibrationfit-db-backup",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "backup"
        }
      }
    }
  ]
}
