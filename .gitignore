# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AWS Lambda artifacts (431MB - too large for git)
lambda-layers/
lambda-video-processor/

# Temporary AWS configs
environment.json

# Large deployment zips
lambda-deploy*.zip

# Old data dumps
production-*.json

# SSL certificates
certs/

# S3 backups
s3-backup/

# Generated documentation (auto-generated, don't commit)
docs/generated/
# macOS metadata files
._*

# Temporary/debug files
temp/

# Capacitor native shells (mobile/): generated + local-only files
mobile/ios/App/Pods/
mobile/ios/App/App/public/
mobile/ios/App/App/capacitor.config.json
mobile/ios/App/App.xcworkspace/xcuserdata/
mobile/ios/App/App.xcodeproj/xcuserdata/
mobile/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
mobile/ios/DerivedData/
mobile/android/.gradle/
mobile/android/.idea/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json
mobile/android/local.properties
mobile/android/*.iml
mobile/android/app/*.iml
mobile/android/capacitor-cordova-android-plugins/build/
mobile/ios/capacitor-cordova-ios-plugins/Pods/
*.keystore
*.jks
mobile/android/keystore.properties

# IDE and personal files
.idea/
HomeSchool Purchase/

# Large local video sources (clips.json / report.md stay tracked)
scripts/video/gym-testimonial-clips/*.mp4
